# Server Configuration
PORT=8080
GIN_MODE=release

# Database
DB_PATH=pokemon_tcg.db

# Redis (optional - enables caching)
REDIS_URL=

# AI Configuration (optional - enables AI features)
# Get free API key from https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Exchange Rate (IDR to USD)
EXCHANGE_RATE=16400

# Data Directory
DATA_DIR=../data

# JWT Secret (for future auth)
JWT_SECRET=your-secret-key-here

# Environment
ENV=development
