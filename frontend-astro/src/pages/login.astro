---
import Layout from '@layouts/Layout.astro';
import LoginForm from '@components/auth/LoginForm';
---

<Layout title="Login">
  <div class="container flex min-h-[calc(100vh-200px)] items-center justify-center px-6 py-10 md:px-8">
    <div class="w-full max-w-md space-y-6">
      <div class="text-center space-y-2">
        <p class="text-xs font-semibold uppercase text-primary">PokeLab ID</p>
        <h1 class="text-3xl font-bold">Masuk ke Research Lab</h1>
        <p class="text-muted-foreground">
          Login diperlukan untuk membaca inventory, rekomendasi deck, dan buy priority milikmu.
        </p>
      </div>

      <LoginForm client:load />

      <p class="text-center text-sm text-muted-foreground">
        Belum punya akun?{' '}
        <a href="/register" data-auth-switch="register" class="font-medium text-primary hover:underline">
          Daftar sekarang
        </a>
      </p>
    </div>
  </div>

  <script is:inline>
    const redirect = new URLSearchParams(window.location.search).get('redirect');
    if (redirect && redirect.startsWith('/') && !redirect.startsWith('//')) {
      document.querySelectorAll('[data-auth-switch="register"]').forEach((link) => {
        link.setAttribute('href', `/register?redirect=${encodeURIComponent(redirect)}`);
      });
    }
  </script>
</Layout>
