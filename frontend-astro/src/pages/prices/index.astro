---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/layout/PageHeader.astro';
import PriceTracker from '@components/prices/PriceTracker';
import { BarChart3, TrendingUp } from 'lucide-react';
---

<Layout title="Price Radar">
  <div class="container px-6 py-10 md:px-8">
    <PageHeader
      eyebrow="Price Radar"
      title="Price Tracker & Upgrade Cost"
      description="Pantau harga pasar dan gunakan sinyal harga sebagai bahan missing card buylist, budget upgrade, dan prediksi kartu meta."
    >
      <a
        slot="actions"
        href="/lab/predictions"
        class="inline-flex h-10 items-center gap-2 rounded-md border border-border bg-card px-4 text-sm font-semibold transition-colors hover:bg-accent"
      >
        <TrendingUp className="h-4 w-4 text-primary" />
        Lihat prediction
      </a>
    </PageHeader>

    <div class="mb-6 grid gap-3 md:grid-cols-3">
      {[
        ['IDR-first', 'Estimasi upgrade memakai harga Rupiah terbaik jika tersedia.'],
        ['Buylist ready', 'Missing card dari PokeLab bisa diprioritaskan berdasarkan cost.'],
        ['Trend signal', 'Pergerakan harga ikut memberi bobot prediksi meta.'],
      ].map(([title, body]) => (
        <div class="rounded-md border border-border bg-card p-4">
          <div class="mb-2 flex items-center gap-2 text-sm font-semibold">
            <BarChart3 className="h-4 w-4 text-primary" />
            {title}
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">{body}</p>
        </div>
      ))}
    </div>

    <PriceTracker client:load />
  </div>
</Layout>
