---
import Layout from '@layouts/Layout.astro';
import {
  BarChart3,
  ChevronRight,
  FlaskConical,
  Layers3,
  Package,
  Search,
  ShieldCheck,
  Sparkles,
  TrendingUp,
  Users,
} from 'lucide-react';

const heroCards = [
  { src: '/landing-cards/meta-lead.webp', name: 'Meta lead', className: 'left-3 top-10 -rotate-12 sm:left-10 sm:top-14' },
  { src: '/landing-cards/tech-card.webp', name: 'Tech card', className: 'right-4 top-10 rotate-12 sm:right-12 sm:top-14' },
  { src: '/landing-cards/trainer-engine.webp', name: 'Trainer engine', className: 'bottom-12 left-8 rotate-6 sm:left-20' },
  { src: '/landing-cards/energy-slot.webp', name: 'Energy slot', className: 'bottom-14 right-8 -rotate-6 sm:right-24' },
];

const countdownStats = [
  { label: 'Cards', value: '13K+' },
  { label: 'Sets', value: '91' },
  { label: 'Decks', value: '46' },
  { label: 'AI', value: 'ON' },
];

const spotlight = [
  {
    title: 'Deck Scout Report',
    description: 'Analisa tiap deck seperti report kompetitif: owner, turnamen, rank, card usage, gap inventory, upgrade plan, dan matchup theory.',
    href: '/decks',
    icon: Layers3,
    image: '/landing-cards/deck-scout.webp',
    meta: 'Deck library',
  },
  {
    title: 'Inventory Research Lab',
    description: 'Masukkan koleksi, lalu PokeLab menghitung deck meta yang paling dekat, missing card, biaya upgrade, dan prioritas beli.',
    href: '/lab',
    icon: FlaskConical,
    image: '/landing-cards/inventory-lab.webp',
    meta: 'PokeLab ID',
  },
  {
    title: 'Meta Prediction Board',
    description: 'Pantau Pokemon, Trainer, Supporter, Stadium, dan Energy yang mulai naik sinyal dari decklist dan hasil turnamen.',
    href: '/lab/predictions',
    icon: TrendingUp,
    image: '/landing-cards/prediction-board.webp',
    meta: 'Trend watch',
  },
  {
    title: 'Card Database',
    description: 'Cari kartu berdasarkan expansion, rarity, type, role, dan kebutuhan deck. Detail kartu diarahkan untuk keputusan deck building.',
    href: '/cards',
    icon: Search,
    image: '/landing-cards/card-database.webp',
    meta: 'Card index',
  },
];

const modules = [
  { label: 'Recommendations', href: '/lab/recommendations', detail: 'Ranking deck meta dari collection aktif' },
  { label: 'Anti-Meta', href: '/lab/anti-meta', detail: 'Counter plan untuk archetype target' },
  { label: 'Collections', href: '/collections', detail: 'Inventory user untuk scoring backend' },
];

const testimonials = [
  ['Deck Builder', 'Akhirnya tahu deck mana yang bisa jadi duluan dari kartu yang sudah saya punya.'],
  ['Collector', 'Filter kartu dan inventory scoring jadi lebih gampang dipakai untuk cek kebutuhan deck.'],
  ['Competitive Player', 'Scout report deck membantu lihat role kartu, bukan cuma daftar 60 kartu.'],
  ['Research Lab', 'AI menjelaskan hasil scoring tanpa mengubah ranking deterministik backend.'],
];
---

<Layout title="Competitive Research Lab">
  <section class="relative overflow-hidden bg-[#111111]">
    <div class="absolute inset-0 opacity-45">
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(239,68,68,0.10),transparent_32%,transparent_72%,rgba(250,204,21,0.08))]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_18%,rgba(255,255,255,0.08),transparent_38%)]"></div>
    </div>

    <div class="relative px-6 py-8 md:px-8 lg:py-12">
      <div class="relative min-h-[620px] overflow-hidden">
        <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-[0.06]"></div>

        {heroCards.map((card) => (
          <div class={`absolute z-10 hidden w-28 rounded-lg border border-white/15 bg-black/30 p-1.5 shadow-2xl sm:block lg:w-32 ${card.className}`}>
            <img src={card.src} alt={card.name} class="aspect-[63/88] w-full rounded-md object-cover" loading="eager" />
          </div>
        ))}

        <div class="relative z-10 flex min-h-[620px] flex-col items-center justify-center px-5 py-12 text-center">

          <h1 class="max-w-4xl text-5xl font-black leading-none text-white md:text-7xl lg:text-8xl">
            Poke<span class="text-red-500">Lab</span>
          </h1>
          <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-300 md:text-base">
            Research lab untuk rekomendasi deck meta, analisa kartu, anti-meta plan, prediksi trend, dan upgrade path berdasarkan inventory user.
          </p>

          <div class="mt-7 grid grid-cols-4 gap-2">
            {countdownStats.map((stat) => (
              <div class="min-w-16 rounded-md border border-white/10 bg-white px-2 py-2 text-center text-black shadow-lg">
                <div class="font-mono text-lg font-black tabular-nums md:text-2xl">{stat.value}</div>
                <div class="mt-1 text-[10px] font-semibold uppercase text-zinc-500">{stat.label}</div>
              </div>
            ))}
          </div>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="/lab" class="inline-flex h-11 items-center justify-center rounded-md bg-red-500 px-5 text-sm font-bold text-white transition-colors hover:bg-red-400">
              Buka Research Lab
              <ChevronRight className="ml-2 h-4 w-4" />
            </a>
            <a href="/cards" class="inline-flex h-11 items-center justify-center rounded-md bg-white px-5 text-sm font-bold text-black transition-colors hover:bg-yellow-200">
              Jelajahi Kartu
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10 bg-[#111111]">
    <div class="container px-6 py-10 md:px-8">
      <div class="grid gap-4 md:grid-cols-3">
        {modules.map((module) => (
          <a href={module.href} class="group rounded-lg border border-white/10 bg-[#191919] p-4 transition-colors hover:border-red-400/60 hover:bg-[#202020]">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-sm font-bold text-white">{module.label}</h2>
              <ChevronRight className="h-4 w-4 text-red-400 transition-transform group-hover:translate-x-1" />
            </div>
            <p class="mt-2 text-xs leading-relaxed text-zinc-400">{module.detail}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#111111]">
    <div class="container px-6 py-14 md:px-8">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <p class="text-xs font-bold uppercase text-red-400">Research Features</p>
        <h2 class="mt-2 text-3xl font-black text-white md:text-4xl">
          Semua workflow kompetitif dalam satu lab.
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {spotlight.map((item) => (
          <a href={item.href} class="group overflow-hidden rounded-lg border border-white/10 bg-[#191919] transition-colors hover:border-red-400/60">
            <div class="relative h-44 overflow-hidden bg-black">
              <img src={item.image} alt={item.title} class="h-full w-full object-cover opacity-85 transition-transform duration-300 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-black/35"></div>
              <span class="absolute left-3 top-3 rounded-md bg-yellow-300 px-2 py-1 text-xs font-black text-black">{item.meta}</span>
            </div>
            <div class="p-4">
              <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-md bg-red-500/15 text-red-300">
                <item.icon className="h-5 w-5" />
              </div>
              <h3 class="text-base font-bold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#151515]">
    <div class="container grid gap-8 px-6 py-14 md:px-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col justify-center">
        <p class="text-xs font-bold uppercase text-red-400">What is PokeLab?</p>
        <h2 class="mt-3 text-3xl font-black text-white md:text-4xl">
          Bukan cuma database. Ini ruang scouting untuk deck building.
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-400">
          PokeLab membaca inventory, decklist turnamen, harga, role kartu, dan sinyal meta. Angka tetap dihitung deterministik di backend, lalu OpenRouter dipakai sebagai coach untuk menjelaskan kenapa rekomendasi itu masuk akal.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/decks" class="inline-flex h-10 items-center rounded-md bg-red-500 px-4 text-sm font-bold text-white hover:bg-red-400">Lihat Deck</a>
          <a href="/collections" class="inline-flex h-10 items-center rounded-md border border-white/15 px-4 text-sm font-bold text-white hover:bg-white/10">Siapkan Inventory</a>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {[
          ['Inventory readiness', 'Completeness, owned count, missing count, dan estimated upgrade cost.', Package],
          ['Anti-meta plan', 'Counter deck, tech card, gangguan utama, dan matchup notes.', ShieldCheck],
          ['Upgrade priority', 'Missing card, substitute, dan budget priority tetap dihitung di backend.', BarChart3],
          ['AI coach', 'Penjelasan Bahasa Indonesia tanpa mengambil alih ranking.', Users],
        ].map(([title, body, Icon]) => (
          <div class="rounded-lg border border-white/10 bg-[#1d1d1d] p-4">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-yellow-300 text-black">
              <Icon className="h-5 w-5" />
            </div>
            <h3 class="text-sm font-bold text-white">{title}</h3>
            <p class="mt-2 text-xs leading-relaxed text-zinc-400">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#111111]">
    <div class="container px-6 py-14 md:px-8">
      <h2 class="mb-7 text-center text-3xl font-black text-white md:text-4xl">
        Apa yang user dapatkan?
      </h2>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        {testimonials.map(([name, quote]) => (
          <div class="rounded-lg border border-white/10 bg-[#191919] p-4">
            <p class="text-sm leading-relaxed text-zinc-300">"{quote}"</p>
            <p class="mt-4 text-xs font-bold uppercase text-red-300">{name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
