---
import Layout from '@layouts/Layout.astro';
import { ArrowLeft, Mail } from 'lucide-react';
---

<Layout title="Lupa Password - Pokemon TCG Indonesia">
  <div class="container px-6 md:px-8 py-16">
    <div class="max-w-md mx-auto">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 mb-4">
          <Mail class="h-6 w-6 text-primary" />
        </div>
        <h1 class="text-2xl font-bold tracking-tight">Lupa Password?</h1>
        <p class="text-muted-foreground mt-2">
          Masukkan email kamu dan kami akan kirimkan link reset password.
        </p>
      </div>

      <div class="rounded-xl border bg-card p-6 shadow-sm">
        <form id="forgot-form" class="space-y-4">
          <div>
            <label class="text-sm font-medium">Email</label>
            <input
              type="email"
              name="email"
              required
              placeholder="nama@email.com"
              class="mt-1 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            />
          </div>
          <button
            type="submit"
            class="w-full inline-flex items-center justify-center rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
          >
            Kirim Link Reset
          </button>
        </form>

        <div id="forgot-message" class="hidden mt-4 rounded-md bg-green-500/10 p-3 text-sm text-green-500">
          Link reset password telah dikirim ke email kamu.
        </div>
      </div>

      <div class="mt-6 text-center">
        <a href="/login" class="inline-flex items-center text-sm text-primary hover:underline">
          <ArrowLeft class="mr-1 h-4 w-4" />
          Kembali ke Login
        </a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('forgot-form');
    const message = document.getElementById('forgot-message');
    
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      message?.classList.remove('hidden');
      form.reset();
    });
  </script>
</Layout>
