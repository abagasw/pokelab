---
export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-8 rounded-lg border border-white/10 bg-[#151515]/80 p-5 shadow-sm">
  {eyebrow && <p class="text-xs font-bold uppercase text-red-400">{eyebrow}</p>}
  <div class="mt-2 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <h1 class="text-3xl font-black leading-tight text-white md:text-4xl">{title}</h1>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground md:text-base">{description}</p>
    </div>
    <slot name="actions" />
  </div>
</header>
