# Copy to .env.deploy, then edit secrets before running:
# docker compose --env-file .env.deploy up -d --build

FRONTEND_PORT=3000
BACKEND_PORT=8080
REDIS_COMMANDER_PORT=8081

JWT_SECRET=change-this-to-a-long-random-production-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
EXCHANGE_RATE=16400

# Auto-Sync Configuration
# Paths on the HOST machine (used for Docker bind mounts)
DB_DIR=./backend-go
CARD_IMAGES_DIR=./frontend-astro/public/card-images
TZ=Asia/Jakarta

# Sync tuning
SYNC_WORKERS=8
SYNC_TIMEOUT=20

# Pokepedia Supabase API Key (REQUIRED for card/image sync)
# Legacy anon keys DISABLED by Supabase since 2026-06-13.
# Get a new publishable key (sb_publishable_*) or secret key (sb_secret_*)
# from the pokepedia.id Supabase dashboard → Settings → API.
POKEPEDIA_API_KEY=
POKEPEDIA_SUPABASE_URL=https://tlauakxyrxpwnwgdywum.supabase.co/rest/v1
