# Copy to .env.deploy, then edit secrets before running:
# docker compose --env-file .env.deploy up -d --build

FRONTEND_PORT=3000
BACKEND_PORT=8080
REDIS_COMMANDER_PORT=8081

JWT_SECRET=change-this-to-a-long-random-production-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
EXCHANGE_RATE=16400

# Auto-Sync Configuration
# Paths on the HOST machine (used for Docker bind mounts)
DB_DIR=./backend-go
CARD_IMAGES_DIR=./frontend-astro/public/card-images
TZ=Asia/Jakarta

# Sync tuning
SYNC_WORKERS=8
SYNC_TIMEOUT=20

# Optional: override Pokepedia API key (default is built-in)
# POKEPEDIA_API_KEY=
# POKEPEDIA_SUPABASE_URL=
